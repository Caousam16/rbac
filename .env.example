# PostgreSQL connection used by the application and Prisma CLI.
DATABASE_URL="postgresql://app:app@localhost:5432/rbac_platform?schema=public"
APP_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Set true in production only when Host / X-Forwarded-Host are controlled by a trusted proxy.
AUTH_TRUST_HOST="false"

# Optional transactional email delivery via Resend's HTTPS API.
# Authentication still works without these values; verification/reset emails require them.
RESEND_API_KEY=""
EMAIL_FROM="RBAC Platform <no-reply@example.com>"

# Step 2 seed creates this administrator INACTIVE and without credentials.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_FIRST_NAME="System"
SEED_ADMIN_LAST_NAME="Administrator"

# One-time local/operations bootstrap. Never commit real values.
# auth:bootstrap-admin refuses to promote a normal user and only activates the
# pre-seeded INACTIVE ADMIN account that does not yet have credentials.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
